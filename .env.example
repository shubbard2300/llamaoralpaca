# Postgres connection string (Vercel Postgres / Neon in production, local in dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/llama_or_alpaca

# Secret used to sign session cookies (JWT). Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Vercel Blob read/write token (Storage tab -> Blob -> create store -> copy token).
# When unset, uploads fall back to writing under public/uploads for local dev only.
BLOB_READ_WRITE_TOKEN=

# Comma-separated list of email addresses allowed to access /admin moderation.
ADMIN_EMAILS=gamecat2300@gmail.com
